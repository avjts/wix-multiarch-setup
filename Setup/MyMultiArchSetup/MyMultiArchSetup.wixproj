<Project Sdk="WixToolset.Sdk/8.0.0-build.7">
  <PropertyGroup>
    <OutputName>MyMultiArchSetup</OutputName>

    <Version Condition=" '$(Version)' == '' ">1.0.0</Version>
    <DefineConstants>MSIProductVersion=$(Version)</DefineConstants>
    <Platforms>ARM64;x64;x86</Platforms>
    <OutputPath>..\_bin\$(Configuration)-$(Platform)\</OutputPath>
    <AcceptEula>wix7;wix8</AcceptEula>
  </PropertyGroup>
  <PropertyGroup>
    <InstallerPlatform Condition=" '$(Platform)' == 'ARM64'">ARM64</InstallerPlatform>
    <InstallerPlatform Condition=" '$(Platform)' == 'ARM64EC'">ARM64</InstallerPlatform>
    <InstallerPlatform Condition=" '$(Platform)' == 'x64'">x64</InstallerPlatform>
    <InstallerPlatform Condition=" '$(Platform)' == 'x86'">x86</InstallerPlatform>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(CustomOutputPath)' != '' ">
    <OutputPath>$(CustomOutputPath)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <SuppressPdbOutput>True</SuppressPdbOutput>
  </PropertyGroup>
  <Import Project="..\Common.props" />
  <ItemGroup>
    <ProjectReference Include="..\CppCustomActions\CppCustomActions.vcxproj">
      <SetPlatform Condition=" '$(Platform)' == 'ARM64'">Platform=ARM64EC</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="..\CSharpCustomActions\CSharpCustomActions.csproj">
      <SetPlatform>Platform=$(InstallerPlatform)</SetPlatform>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="8.0.0-build.7" />
  </ItemGroup>
</Project>
